{
  "name": "kapit-backend",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "start": "node --require tsx/cjs api/server.ts",
    "watch": "node --require tsx/cjs --watch api/server.ts",
    "test": "node --require tsx/cjs ../scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "migrate:posts:reassign-owner": "node --require tsx/cjs api/scripts/reassignPostOwnership.ts",
    "fastapi:dev": "node --require tsx/cjs scripts/start-fastapi-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.3",
    "clamscan": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "docx": "^9.7.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
