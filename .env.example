# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foundit_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=false

# Optional single-string connection URL
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# Optional: old local PostgreSQL database for one-time user migration into Supabase
# LEGACY_DATABASE_URL=postgresql://user:password@legacy-host:5432/database
# LEGACY_DB_SSL=false

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRE=20m
JWT_REFRESH_EXPIRE_DAYS=14
ACCESS_TOKEN_COOKIE_NAME=kapit_access_token
REFRESH_TOKEN_COOKIE_NAME=kapit_refresh_token
CSRF_COOKIE_NAME=kapit_csrf_token
BCRYPT_SALT_ROUNDS=12
PASSWORD_HASHER=bcrypt
LOGIN_RATE_LIMIT_MAX=10
AUTH_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_MAX=180
MESSAGES_READ_RATE_LIMIT_MAX=120
MESSAGES_WRITE_RATE_LIMIT_MAX=30
NOTIFICATIONS_RATE_LIMIT_MAX=90
COMPANY_API_RATE_LIMIT_MAX=180
COMPANY_WRITE_RATE_LIMIT_MAX=45
DEVELOPER_API_RATE_LIMIT_MAX=90

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_CSRF_COOKIE_NAME=kapit_csrf_token
CORS_ALLOWED_ORIGINS=
JSON_BODY_LIMIT=200kb
URLENCODED_BODY_LIMIT=200kb
URLENCODED_PARAMETER_LIMIT=200
EXPRESS_API_URL=http://localhost:5000/api
FASTAPI_URL=http://localhost:8000

# Local-only dev payment bypass
# Put these in a local .env.local file instead of committing them.
ENABLE_LOCAL_PAYMENT_BYPASS=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
