# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foundit_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=false

# Optional single-string connection URL
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# Optional: old local PostgreSQL database for one-time user migration into Supabase
# LEGACY_DATABASE_URL=postgresql://user:password@legacy-host:5432/database
# LEGACY_DB_SSL=false

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional frontend API base URL (if not using Vite proxy)
VITE_API_URL=/api/auth
VITE_API_BASE=/api

# Local-only dev payment bypass
# Put these in a local .env.local file instead of committing them.
VITE_ENABLE_LOCAL_PAYMENT_BYPASS=false
ENABLE_LOCAL_PAYMENT_BYPASS=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
