# Never commit real secrets.
# Configure production values in provider environment-variable settings.

##  Server runtime
PORT=5001
HOST=127.0.0.1
NODE_ENV=development
QUIET_STARTUP=false
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=debug

##  Local dev orchestration
NEXTJS_HOST=127.0.0.1
NEXTJS_PORT=3000
FRONTEND_SCRIPT=dev
REUSE_EXISTING_BACKEND=false
BACKEND_WATCH=false
HIDE_NEXT_NETWORK_LINE=false
HIDE_NEXT_REQUEST_LINES=true
FORCE_CLEAN_NEXT_DEV=true
NEXT_USE_TURBOPACK=true
NEXT_TELEMETRY_DISABLED=1

## Database Config

DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DB_HOST=<db_host>
DB_PORT=5432
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_SSL=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Defaults depend on host/provider
DB_SSL_REJECT_UNAUTHORIZED=

##  Auth and session
JWT_SECRET=<replace-with-strong-access-secret-32-plus-chars>
JWT_REFRESH_SECRET=<replace-with-strong-refresh-secret-32-plus-chars>
JWT_ACCESS_EXPIRE=20m
JWT_REFRESH_EXPIRE_DAYS=14
ACCESS_TOKEN_COOKIE_NAME=kapit_access_token
REFRESH_TOKEN_COOKIE_NAME=kapit_refresh_token
CSRF_COOKIE_NAME=kapit_csrf_token
BCRYPT_SALT_ROUNDS=12
PASSWORD_HASHER=bcrypt
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_URL_BASE=https://yourdomain.com/reset-password
PASSWORD_RESET_CLEANUP_INTERVAL_MS=300000
OTP_TTL_MINUTES=10

##  API/security tuning
JSON_BODY_LIMIT=200kb
URLENCODED_BODY_LIMIT=200kb
URLENCODED_PARAMETER_LIMIT=200
SUCCESS_RESPONSE_DATA_ENVELOPE=false
LOGIN_RATE_LIMIT_MAX=10
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
RESET_PASSWORD_RATE_LIMIT_MAX=3
AUTH_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_MAX=180
MESSAGES_READ_RATE_LIMIT_MAX=120
MESSAGES_WRITE_RATE_LIMIT_MAX=30
NOTIFICATIONS_RATE_LIMIT_MAX=90
COMPANY_API_RATE_LIMIT_MAX=180
COMPANY_WRITE_RATE_LIMIT_MAX=45
DEVELOPER_API_RATE_LIMIT_MAX=90
HSTS_MAX_AGE=31536000

##  URLs and CORS
CLIENT_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5001/api
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_BUILD_VERSION=local-dev

#  Production web build targets (used when NODE_ENV=production)
NEXT_PUBLIC_EXPRESS_API_URL_PRODUCTION=https://your-api.example.com/api
NEXT_PUBLIC_FASTAPI_URL_PRODUCTION=
NEXT_PUBLIC_CSRF_COOKIE_NAME=kapit_csrf_token
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173
ALLOW_KAPIT_NETLIFY_PREVIEW=false
EXPRESS_API_URL=http://localhost:5001/api
FASTAPI_URL=http://localhost:8000
EXPRESS_API_URL_PRODUCTION=https://your-api.example.com/api
FASTAPI_URL_PRODUCTION=
FASTAPI_TIMEOUT_MS=12000

##  Messaging rollout controls
MESSAGING_DEBUG_TOKEN=<replace-with-random-debug-token>
LOG_MESSAGING_MIGRATION=false
MESSAGES_READ_SHADOW_COMPARE=true
MESSAGES_READ_SOURCE=conversations
MESSAGES_READ_ROLLOUT_PERCENT=100
MESSAGES_READ_ALLOWLIST=
SCHEMA_MANAGEMENT_MODE=migrations
MATCH_JOBS_CACHE_TTL_MS=120000
FEATURED_COMPANY_RECENT_HIRE_DAYS=60
FEATURED_COMPANY_NEW_DAYS=180
FEATURED_COMPANY_LIMIT=10
FREE_COMPANY_ACTIVE_JOB_LIMIT=2

##  Redis for distributed rate limits
REDIS_URL=
LOG_REDIS_STATUS=false
REDIS_CONNECT_TIMEOUT_MS=750
REDIS_FAILOPEN_COOLDOWN_MS=30000

## Local bypass (dev only)
ENABLE_LOCAL_AUTH_BYPASS=false
ENABLE_LOCAL_PAYMENT_BYPASS=false
NEXT_PUBLIC_ENABLE_LOCAL_AUTH_BYPASS=false
NEXT_PUBLIC_ENABLE_LOCAL_PAYMENT_BYPASS=false

## Payments
PAYPAL_CLIENT_ID=<paypal-client-id>
PAYPAL_CLIENT_SECRET=<paypal-client-secret>
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYMENT_API_TIMEOUT_MS=10000
PAYMENT_API_RETRY_MAX=3
PAYMENT_API_RETRY_BASE_MS=300
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400

##  Email provider (Resend)
EMAIL_FROM=KapIT <no-reply@yourdomain.com>
RESEND_API_KEY=

##  OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

##  Uploads 
RESUME_UPLOAD_DIR=
RESUME_UPLOAD_MAX_BYTES=5242880
