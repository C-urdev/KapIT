{
  "name": "kapit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "server": "node server/server.js",
    "server:watch": "nodemon server/server.js",
    "start": "node scripts/start-dev.js",
    "migrate:legacy-users": "node server/scripts/migrateLegacyUsers.js",
    "migrate:posts:reassign-owner": "node server/scripts/reassignPostOwnership.js",
    "migrate:messages:backfill": "node server/scripts/backfillLegacyMessagesToConversations.js",
    "migrate:messages:verify": "node server/scripts/backfillLegacyMessagesToConversations.js --verify",
    "migrate:messages:parity": "node server/scripts/verifyMessagingParity.js",
    "migrate:messages:parity:strict": "node server/scripts/verifyMessagingParity.js --fail-on-mismatch",
    "audit": "npm audit --audit-level=high",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "build": "node scripts/run-web.js build",
    "test": "node --test \"server/tests/**/*.test.cjs\"",
    "next:dev": "node scripts/run-web.js dev",
    "next:build": "node scripts/run-web.js build",
    "fastapi:dev": "cd services/ai-fastapi && uvicorn main:app --reload --port 8000"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "stripe": "^18.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
