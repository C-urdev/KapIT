{
  "name": "kapit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/start-dev.ts",
    "prepare": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/install-githooks.ts",
    "server": "pnpm --dir backend run start",
    "server:watch": "pnpm --dir backend run watch",
    "start": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/start-dev.ts",
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:start": "pnpm --dir frontend run start",
    "backend:start": "pnpm --dir backend run start",
    "backend:watch": "pnpm --dir backend run watch",
    "migrate:posts:reassign-owner": "pnpm --dir backend run migrate:posts:reassign-owner",
    "security:guard": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/security-guard.ts",
    "security:secrets": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/security-guard.ts --all",
    "audit": "pnpm --dir backend audit --audit-level=high --prod && pnpm --dir frontend audit --audit-level=high --prod",
    "audit:ci": "pnpm --dir backend audit --audit-level=high --prod && pnpm --dir frontend audit --audit-level=high --prod",
    "build": "pnpm --dir frontend run build",
    "build:vercel": "pnpm --dir frontend install --frozen-lockfile && pnpm --dir frontend run build",
    "test": "pnpm --dir backend run test",
    "lint": "pnpm --dir frontend run lint",
    "sync-skills": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/sync-skills.ts",
    "sync-skills:test": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs --test scripts/tests/sync-skills.test.ts",
    "fastapi:dev": "pnpm --dir backend run fastapi:dev",
    "db:migrate:dry": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/apply-db-migrations.ts --dry-run",
    "db:migrate:staging": "node --require ./backend/node_modules/tsx/dist/cjs/index.cjs scripts/apply-db-migrations.ts --env=STAGING_DATABASE_URL"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
