{
  "name": "kapit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "server": "node server/server.js",
    "server:watch": "nodemon server/server.js",
    "start": "node scripts/start-dev.js",
    "migrate:legacy-users": "node server/scripts/migrateLegacyUsers.js",
    "migrate:messages:backfill": "node server/scripts/backfillLegacyMessagesToConversations.js",
    "migrate:messages:verify": "node server/scripts/backfillLegacyMessagesToConversations.js --verify",
    "migrate:messages:parity": "node server/scripts/verifyMessagingParity.js",
    "migrate:messages:parity:strict": "node server/scripts/verifyMessagingParity.js --fail-on-mismatch",
    "build": "node scripts/run-web-next.js build",
    "next:dev": "node scripts/run-web-next.js dev",
    "next:build": "node scripts/run-web-next.js build",
    "fastapi:dev": "cd services/ai-fastapi && uvicorn main:app --reload --port 8000"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "stripe": "^18.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
