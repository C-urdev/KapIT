{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./modules/shared/*"],
      "@sharedComponents/*": ["./modules/shared/components/*"],
      "@sharedPages/*": ["./modules/shared/pages/*"],
      "@sharedContext/*": ["./modules/shared/context/*"],
      "@sharedServices/*": ["./modules/shared/services/*"],
      "@sharedUtils/*": ["./modules/shared/utils/*"],
      "@user/*": ["./modules/user/*"],
      "@userComponents/*": ["./modules/user/components/*"],
      "@userPages/*": ["./modules/user/pages/*"],
      "@userFeatures/*": ["./modules/user/features/*"],
      "@userLayouts/*": ["./modules/user/layouts/*"],
      "@company/*": ["./modules/company/*"],
      "@companyComponents/*": ["./modules/company/components/*"],
      "@companyPages/*": ["./modules/company/pages/*"],
      "@companyFeatures/*": ["./modules/company/features/*"],
      "@companyLayouts/*": ["./modules/company/layouts/*"]
    }
  },
  "include": ["src", "components", "lib", "modules", "vite.config.mjs", "eslint.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
